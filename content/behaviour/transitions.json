{
 "attributes": [
  {
   "id": "anxiety",
   "min": 0,
   "max": 10,
   "start": 3,
   "driven_by": "explanation and reassurance lower it; unexplained actions and waits raise it"
  },
  {
   "id": "trust",
   "min": 0,
   "max": 10,
   "start": 5,
   "driven_by": "introduction and honesty raise it; a dismissive reply or ignoring questions lowers it"
  },
  {
   "id": "cooperation",
   "min": 0,
   "max": 10,
   "start": 5,
   "driven_by": "trust and understanding raise it; a dismissive reply lowers it"
  },
  {
   "id": "understanding",
   "min": 0,
   "max": 10,
   "start": 3,
   "driven_by": "plain language and teach-back raise it; jargon lowers it"
  },
  {
   "id": "pain",
   "min": 0,
   "max": 10,
   "start": 0,
   "driven_by": "read from the physiology (the pain score) and lowered by analgesia"
  },
  {
   "id": "fear",
   "min": 0,
   "max": 10,
   "start": 2,
   "driven_by": "risks discussed without support raise it; reassurance lowers it; an approved event raises it"
  },
  {
   "id": "frustration",
   "min": 0,
   "max": 10,
   "start": 0,
   "driven_by": "repeated questions and long waits raise it; analgesia lowers it"
  },
  {
   "id": "confusion",
   "min": 0,
   "max": 3,
   "start": 0,
   "driven_by": "driven by the physiology (low oxygen, low sugar, sepsis) and by jargon"
  },
  {
   "id": "willingness",
   "min": 0,
   "max": 10,
   "start": 5,
   "driven_by": "follows trust; gates the disclosure of sensitive facts"
  }
 ],
 "persona": {
  "communication_style": "talkative",
  "question_frequency": 0.5,
  "need_for_reassurance": 1.0,
  "communication_difficulty": "none"
 },
