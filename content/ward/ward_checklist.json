  {
   "id": "fasting",
   "order": 1,
   "label": "Fasting times re-confirmed (a breach must be passed to the anaesthetist)",
   "verify_if": {
    "and": [
     {
      "!=": [
       {
        "var": "fasting"
       },
       "unknown"
      ]
     },
     {
      "or": [
       {
        "!=": [
         {
          "var": "fasting"
         },
         "breach"
        ]
       },
       {
        "in": [
         "anaesthetist.told.fasting",
         {
          "var": "flags"
         }
        ]
       }
      ]
     }
    ]
   },
   "required": true,
   "required_if": null,
   "critical": false,
   "action": null,
