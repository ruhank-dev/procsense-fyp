{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procsense.local/schema/workflow.schema.json",
  "title": "ProcSense case workflow",
  "description": "Goals, decision points and readiness blockers for the case graph (Core: ProcSense.Core.Workflow.CaseGraph). All conditions are rules in the JsonLogic subset (rule.schema.json). Every entry names its source-register ids.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goals",
    "decision_points",
    "blockers"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]*$"
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^SR-[0-9]{4}$"
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]*$"
    },
    "step": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    },
    "event": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]*$"
    }
  },
  "properties": {
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "step",
          "label",
          "hint",
          "applies_if",
          "complete_if",
          "after",
          "on_missed",
          "score_items",
          "refs"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "step": {
            "$ref": "#/$defs/step"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "hint": {
            "type": "string",
            "minLength": 1
          },
          "applies_if": {
            "description": "Rule logic: does this goal apply to the case?"
          },
          "complete_if": {
            "description": "Rule logic: is the goal done?"
          },
          "after": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "description": "Goals that must be complete first (a hard order; cycles are a load error)."
          },
          "deadline_min": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Minutes of simulated time from the start of the session."
          },
          "on_missed": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "flags",
              "events"
            ],
            "properties": {
              "flags": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/name"
                }
              },
              "events": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/event"
                }
              }
            }
          },
          "score_items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "refs": {
            "$ref": "#/$defs/refs"
          }
        }
      }
    },
    "decision_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "step",
          "label",
          "trigger",
          "options",
          "expected",
          "refs"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "step": {
            "$ref": "#/$defs/step"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "description": "Rule logic: when does the decision card appear?"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "set_flags",
                "events_enable",
                "score_item"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "set_flags": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/name"
                  }
                },
                "events_enable": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/event"
                  }
                },
                "score_item": {
                  "type": "string"
                }
              }
            }
          },
          "expected": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "refs": {
            "$ref": "#/$defs/refs"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "check_at",
          "blocked_if",
          "message",
          "refs"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "check_at": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/name"
            }
          },
          "blocked_if": {
            "description": "Rule logic: when is the verb blocked?"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "Why it is blocked, in words the trainee can act on."
          },
          "refs": {
            "$ref": "#/$defs/refs"
          }
        }
      }
    }
  }
}
