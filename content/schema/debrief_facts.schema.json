{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "debrief_facts.v1",
 "description": "The structured facts of one session: the result, every score item with the sentence that states it and the log entries behind it, the score per assessed behaviour, the timeline, the events, the lateness and the sources. A template or an AI debrief may rephrase these facts and add nothing.",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema", "case", "mode", "end_state", "result", "items", "competencies", "timeline", "lateness", "events", "not_shown", "sources"],
 "properties": {
  "schema": { "const": "debrief_facts.v1" },
  "case": { "type": "string", "minLength": 1 },
  "mode": { "enum": ["practice", "assessment"] },
  "end_state": { "type": "string", "enum": ["", "READY_SAFE", "POSTPONED_APPROPRIATELY", "REDIRECTED_APPROPRIATELY", "SAFE_BUT_DELAYED", "SAFETY_FAILURE"] },
  "result": { "enum": ["SUCCESS", "SUCCESS_WITH_DELAY", "FAIL", "IN_PROGRESS"] },
  "items": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "behaviour", "severity", "status", "points", "evidence", "rule_id", "source", "sentence"],
    "properties": {
     "id": { "type": "string", "pattern": "^(credit|minor|major|critical|info)\\.[a-z0-9_]+$" },
     "behaviour": { "type": "string" },
     "severity": { "enum": ["credit", "minor", "major", "critical", "info"] },
     "status": { "enum": ["credit", "penalty", "critical", "info", "teaching"] },
     "points": { "type": "integer" },
     "evidence": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
     "rule_id": { "type": "string" },
     "source": { "type": "string" },
     "sentence": { "type": "string", "minLength": 1 }
    }
   }
  },
  "competencies": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["behaviour", "label", "credits", "penalties", "net", "weight", "items"],
    "properties": {
     "behaviour": { "type": "string", "pattern": "^b[0-9]{2}$" },
     "label": { "type": "string" },
     "credits": { "type": "integer", "minimum": 0 },
     "penalties": { "type": "integer", "minimum": 0 },
     "net": { "type": "integer" },
     "weight": { "type": "number" },
     "items": { "type": "integer", "minimum": 0 }
    }
   }
  },
  "timeline": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["step", "time", "kind", "text", "seq"],
    "properties": {
     "step": { "type": "integer", "minimum": 0 },
     "time": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9])?$" },
     "kind": { "enum": ["action", "item", "end_state"] },
     "text": { "type": "string" },
     "seq": { "type": "integer", "minimum": -1 }
    }
   }
  },
  "lateness": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["what", "minutes", "source"],
    "properties": { "what": { "type": "string" }, "minutes": { "type": "number", "minimum": 0 }, "source": { "type": "string", "pattern": "^SR-[0-9]{4}$" } }
   }
  },
  "events": { "type": "array", "items": { "type": "string" } },
  "not_shown": { "type": "array", "items": { "type": "string", "pattern": "^b[0-9]{2}$" } },
  "sources": { "type": "array", "items": { "type": "string", "pattern": "^SR-[0-9]{4}$" } },
  "accepted_actions": { "type": "array", "description": "Every accepted action in the order it happened (the timeline holds only those the scoring maps to a behaviour).", "items": { "type": "object", "additionalProperties": false, "required": ["seq", "time", "verb"], "properties": { "seq": { "type": "integer", "minimum": 0 }, "time": { "type": "string" }, "verb": { "type": "string", "minLength": 1 } } } },
 "generated": { "type": "object", "description": "Present only for a case composed by the generator: where it came from.", "additionalProperties": false, "required": ["spine", "status", "tier", "package_sha256"],
    "properties": { "spine": { "type": "string" }, "status": { "const": "GENERATED_PRACTICE_ONLY" }, "tier": { "enum": ["P0", "P1", "P2"] }, "package_sha256": { "type": "string", "pattern": "^([0-9a-f]{64})?$" } } }
 }
}
