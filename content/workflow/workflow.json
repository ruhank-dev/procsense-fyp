{
  "goals": [
    {
      "id": "G-S1-IDENTITY",
      "step": 1,
      "label": "Identity confirmed",
      "hint": "Ask the patient to say their full name and date of birth, then compare it with the wristband and the notes.",
      "applies_if": true,
      "complete_if": { "==": [ { "var": "identity_confirmed" }, true ] },
      "after": [],
      "on_missed": { "flags": [], "events": [] },
      "score_items": [],
      "refs": [ "SR-0038" ]
    },
    {
      "id": "G-S1-ALLERGY",
      "step": 1,
      "label": "Allergies asked",
      "hint": "Ask about allergies, and what happened when the patient had one.",
      "applies_if": true,
      "complete_if": { "==": [ { "var": "allergies_known" }, true ] },
      "after": [ "G-S1-IDENTITY" ],
      "on_missed": { "flags": [], "events": [] },
      "score_items": [],
      "refs": [ "SR-0039" ]
    },
    {
      "id": "G-S1-REASON",
      "step": 1,
      "label": "Reason for admission asked",
      "hint": "Ask the patient what operation they are here for.",
      "applies_if": true,
      "complete_if": { "in": [ "reason_for_admission", { "var": "topics" } ] },
      "after": [ "G-S1-IDENTITY" ],
      "on_missed": { "flags": [], "events": [] },
      "score_items": [],
      "refs": [ "SR-0040" ]
    },
    {
      "id": "G-S1-ADULT",
      "step": 1,
      "label": "Responsible adult asked",
      "hint": "Check that an adult can take the patient home and stay with them for 24 hours.",
      "applies_if": { "==": [ { "var": "scenario" }, "S1" ] },
      "complete_if": { "in": [ "responsible_adult", { "var": "topics" } ] },
      "after": [ "G-S1-IDENTITY" ],
      "on_missed": { "flags": [], "events": [] },
      "score_items": [],
      "refs": [ "SR-0041" ]
    },
    {
      "id": "G-FASTING",
      "step": 2,
      "label": "Fasting checked",
      "hint": "Ask when the patient last ate and last drank, and compare with the time of anaesthesia.",
      "applies_if": true,
      "complete_if": { "!=": [ { "var": "fasting" }, "unknown" ] },
      "after": [ "G-S1-IDENTITY" ],
      "on_missed": { "flags": [], "events": [] },
      "score_items": [],
      "refs": [ "SR-0050" ]
    },
    {
      "id": "G-EXAM-PERMISSION",
      "step": 4,
      "label": "Permission asked before examining",
      "hint": "Ask the patient's permission before you examine them (offer a chaperone if the hospital requires one).",
      "applies_if": true,
      "complete_if": { "in": [ "exam.permission_asked", { "var": "flags" } ] },
      "after": [ "G-S1-IDENTITY" ],
      "on_missed": { "flags": [], "events": [] },
      "score_items": [],
      "refs": [ "SR-0045" ]
    },
    {
      "id": "G-EXAM-REGIONS",
      "step": 4,
      "label": "Patient examined",
      "hint": "Examine the patient, starting away from the area that hurts.",
      "applies_if": { ">": [ { "var": "exam_total" }, 0 ] },
      "complete_if": { ">=": [ { "var": "exam_done" }, { "var": "exam_total" } ] },
      "after": [ "G-EXAM-PERMISSION" ],
      "on_missed": { "flags": [], "events": [] },
      "score_items": [],
      "refs": [ "SR-0046" ]
    },
    {
      "id": "G-EXAM-AIRWAY",
      "step": 4,
      "label": "Airway checked",
      "hint": "Check the airway: mouth opening, Mallampati, neck movement and thyromental distance.",
      "applies_if": { ">": [ { "var": "airway_total" }, 0 ] },
      "complete_if": { ">=": [ { "var": "airway_done" }, { "var": "airway_total" } ] },
      "after": [ "G-EXAM-PERMISSION" ],
      "on_missed": { "flags": [], "events": [] },
      "score_items": [],
      "refs": [ "SR-0047" ]
    },
    {
      "id": "G-RISK-ASA",
      "step": 5,
      "label": "ASA grade proposed",
      "hint": "Propose an ASA grade for the patient on the Assess tab.",
      "applies_if": true,
      "complete_if": { "in": [ "risk.asa_proposed", { "var": "flags" } ] },
      "after": ["G-EXAM-PERMISSION"],
      "on_missed": { "flags": [], "events": [] },
      "score_items": [],
      "refs": [ "SR-0057" ]
    },
    {
      "id": "G-RISK-VTE",
      "step": 5,
      "label": "Clot and bleeding risk form completed",
      "hint": "Answer every item of the clot and bleeding risk form.",
      "applies_if": true,
      "complete_if": { "in": [ "vte.done", { "var": "flags" } ] },
      "after": ["G-EXAM-PERMISSION"],
      "on_missed": { "flags": [], "events": [] },
      "score_items": [],
      "refs": [ "SR-0058" ]
    },
    {
      "id": "G-ANAES-REVIEW",
      "step": 5,
      "label": "Anaesthetist called",
      "hint": "Call the anaesthetist and present the summary.",
      "applies_if": true,
      "complete_if": { "in": [ "anaesthetist.called", { "var": "flags" } ] },
      "after": ["G-RISK-ASA"],
      "on_missed": { "flags": [], "events": [] },
      "score_items": [],
      "refs": [ "SR-0059" ]
    },
    {
      "id": "G-ANAES-PLAN",
      "step": 5,
      "label": "Anaesthetic plan agreed",
      "hint": "Agree the anaesthetic plan with the anaesthetist.",
      "applies_if": true,
      "complete_if": { "in": [ "anaesthetic.plan_agreed", { "var": "flags" } ] },
      "after": ["G-ANAES-REVIEW"],
      "on_missed": { "flags": [], "events": [] },
      "score_items": [],
      "refs": [ "SR-0060" ]
    },
    {
      "id": "G-READY",
      "step": 5,
      "label": "Readiness decision made",
      "hint": "Choose: proceed, optimise, more tests, review or postpone.",
      "applies_if": true,
      "complete_if": { "in": [ "ready.decided", { "var": "flags" } ] },
      "after": ["G-ANAES-PLAN"],
      "on_missed": { "flags": [], "events": [] },
      "score_items": [],
      "refs": [ "SR-0061" ]
    },
    {
      "id": "G-TESTS",
      "step": 6,
      "label": "The tests this patient needs are ordered",
      "hint": "Order the tests this patient needs, and only those.",
      "applies_if": true,
      "complete_if": { "in": [ "tests.needed_ordered", { "var": "flags" } ] },
      "after": ["G-S1-IDENTITY"],
      "on_missed": { "flags": [], "events": [] },
      "score_items": [],
      "refs": [ "SR-0086" ]
    },
    {
      "id": "G-RESULTS",
      "step": 7,
      "label": "The results are opened",
      "hint": "Open every result you ordered and read it.",
      "applies_if": true,
      "complete_if": { "in": [ "tests.needed_reviewed", { "var": "flags" } ] },
      "after": ["G-TESTS"],
      "on_missed": { "flags": [], "events": [] },
      "score_items": [],
      "refs": [ "SR-0086" ]
    },
    {
      "id": "G-SENIOR-NOW",
      "step": 4,
      "label": "Senior called now",
      "hint": "A rigid, board-like abdomen is an emergency: call the senior now.",
      "applies_if": true,
      "active_if": { "in": [ "finding.rigid_abdomen", { "var": "flags" } ] },
      "complete_if": { "in": [ "escalated.senior", { "var": "flags" } ] },
      "after": [],
      "on_missed": { "flags": [], "events": [] },
      "score_items": [],
      "refs": [ "SR-0048" ]
    }
  ],
  "decision_points": [
    {
      "id": "DP-S1-FAST",
      "step": 2,
      "label": "The fasting time has not been reached",
      "trigger": { "in": [ "fasting.breach", { "var": "flags" } ] },
      "options": [
        { "id": "proceed", "label": "Carry on as planned", "set_flags": [ "fasting.proceeded_despite_breach" ], "events_enable": [], "score_item": "critical.proceed_despite_fasting_breach" },
        { "id": "inform_and_delay", "label": "Tell the anaesthetist and delay the operation until the fasting time is met", "set_flags": [ "fasting.anaesthetist_informed" ], "events_enable": [ "E-OT-DELAY" ], "score_item": "credit.fasting_informed_and_delayed" }
      ],
      "expected": [ "inform_and_delay" ],
      "refs": [ "SR-0051" ]
    }
  ],
  "blockers": [
    {
      "id": "B-READINESS",
      "check_at": [ "transfer_to_theatre" ],
      "blocked_if": { "in": [ "readiness.blocked", { "var": "flags" } ] },
      "message": "Fasting breach unresolved: the anaesthetist has not agreed to go ahead.",
      "refs": [ "SR-0062" ]
    },
    {
      "id": "B-CRITICAL",
      "check_at": [ "transfer_to_theatre" ],
      "blocked_if": { "in": [ "critical.unacknowledged", { "var": "flags" } ] },
      "message": "A critical result has not been dealt with: answer the lab's call, confirm the patient, read the values back, then acknowledge it with an action and a note.",
      "refs": [ "SR-0078" ]
    },
    {
      "id": "B-RESULTS",
      "check_at": [ "transfer_to_theatre" ],
      "blocked_if": { "in": [ "results.unreviewed_required", { "var": "flags" } ] },
      "message": "A result this patient needed has not been opened: review it first.",
      "refs": [ "SR-0079" ]
    },
    {
      "id": "B-PREGNANCY",
      "check_at": [ "transfer_to_theatre" ],
      "blocked_if": { "in": [ "pregnancy.status_required", { "var": "flags" } ] },
      "message": "Pregnancy status required: ask the patient privately, or offer a pregnancy test with consent.",
      "refs": [ "SR-0087" ]
    },
    {
      "id": "B-WARD",
      "check_at": [ "transfer_to_theatre" ],
      "blocked_if": { "!": [ { "in": [ "ward.checklist_signed", { "var": "flags" } ] } ] },
      "message": "The ward checklist is not signed: complete and sign it before the transfer.",
      "refs": [ "SR-2830" ]
    },
    {
      "id": "B-OR",
      "check_at": [ "complete_time_out" ],
      "blocked_if": { "!": [ { "in": [ "or.ready", { "var": "flags" } ] } ] },
      "message": "The theatre is not ready: check every station, report and replace any fault, then declare the theatre ready.",
      "refs": [ "SR-2832" ]
    },
    {
      "id": "B-CONSENT",
      "check_at": [ "transfer_to_theatre" ],
      "blocked_if": { "!": [ { "in": [ "consent.signed", { "var": "flags" } ] } ] },
      "message": "There is no valid consent: do the consent conversation and sign before the transfer.",
      "refs": [ "SR-2855" ]
    }
  ]
}
