# The dedicated SYNTHETIC FYP DEMONSTRATION profile (ADR-0028, amended 27 Oct 2026). Non-secret. Use it only for the controlled demonstration with invented people:
#   task server-demo                                                (runs the service with this profile)
#   docker run --env-file server/demo/synthetic-fyp-demo.env ...    (the image with this profile)
# Gemma 4 31B Cloud is then the default and preferred reader of spoken orders; the offline grammar answers only when Gemma is unavailable, slow or not allowed.
# NEVER use this profile, and never set CLOUD_SYNTHETIC_DEPLOYMENT, where real trainees play: the service refuses to start with APP_ENV=prod or with CLOUD_TRAINEE_DATA_APPROVED=1 beside it.
# The shipped defaults (server/.env.example, server/config.py) stay OFF for everything below.
APP_ENV=dev
CLOUD_ROUTING_ENABLED=1
CLOUD_SYNTHETIC_DEPLOYMENT=1
CLOUD_TRAINEE_DATA_APPROVED=0
# the model host: the local Ollama signed in to the Ollama account, which relays gemma4:31b-cloud (free plan, one cloud request at a time)
OLLAMA_URL=http://127.0.0.1:11434
