# Copy this file to server/.env (git-ignored) and fill in the real values from the password manager.
# Never commit real values: CI refuses a pushed key, token or database password (tools/ci/repo_checks.py).
# Every value below is a placeholder.

APP_ENV=dev

# Supabase project procsense-dev (public values; the reference is not a secret)
SUPABASE_URL=https://PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY

# SECRET. Server only: the host's environment variables, GitHub secrets and this local file. Never in the headset, a web page or git.
SUPABASE_SECRET_KEY=REPLACE_WITH_SECRET_KEY

# The application connects through the TRANSACTION pooler (port 6543). Prepared statements are switched off in code for this connection.
# Copy the exact host and user from the dashboard (Connect > Direct > Transaction pooler); the user looks like postgres.PROJECT-REF.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT-REF:YOUR-PASSWORD@POOLER-HOST:6543/postgres

# Migrations, backups and restores use the SESSION pooler (port 5432, IPv4). Never run migrations through the transaction pooler.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.PROJECT-REF:YOUR-PASSWORD@POOLER-HOST:5432/postgres

# Login tokens: the issuer and the key set address are derived from SUPABASE_URL (the project publishes its public keys at /auth/v1/.well-known/jwks.json).
# Optional, with these defaults: SUPABASE_JWT_AUDIENCE=authenticated, JWKS_CACHE_SECONDS=600, CLOCK_LEEWAY_SECONDS=10, INVITATION_DAYS=14

# Verification of uploaded sessions (p1-backend-s09). The engine's command line and a folder of content, one subfolder per content version (task server-engine-prepare builds both for the image).
# Empty ENGINE_CLI = verification is off and uploaded sessions wait as pending. A JSON list also works: ["dotnet", "/path/procsense-sim.dll"].
ENGINE_CLI=
ENGINE_CONTENT_ROOT=
VERIFY_TIMEOUT_SECONDS=60
VERIFY_BATCH=5
VERIFY_ON_UPLOAD=true
# SECRET. Lets a scheduled job call POST /internal/verify-pending (header X-Internal-Key). Empty = that route does not exist.
INTERNAL_KEY=

# Limits and versions (read by the service; defaults live in server/config.py once it exists)
MAX_UPLOAD_BYTES=2097152
MAX_PACKAGE_BYTES=1048576
UPLOAD_RATE_PER_HOUR=120
# Privacy (p1-backend-s12): design values to be confirmed with a qualified person (DT-127).
CONSENT_REQUIRED_FOR_UPLOAD=true
RETENTION_SESSION_MONTHS=24
RETENTION_ACCESS_LOG_MONTHS=24
RETENTION_AI_CALL_MONTHS=12
# Headset sign-in with a code (p1-backend-s10). Empty address = this service's own /device address; set it to the web dashboard's /device page once that exists.
DEVICE_VERIFICATION_URI=
DEVICE_LOGIN_MINUTES=10
DEVICE_POLL_SECONDS=5
DEVICE_ACCESS_MINUTES=15
DEVICE_REFRESH_DAYS=30
DEVICE_START_PER_HOUR=30
DEVICE_DECIDE_PER_HOUR=30
SUPPORTED_ENGINE_VERSIONS=
SUPPORTED_CONTENT_VERSIONS=
# Semantic reader (p1-ai-language-s18, ADR-0024): a large model on Ollama Cloud proposes a reading of an utterance; deterministic checks decide. OFF by default; the speech_interpretation evaluation gate is separate and also OFF.
# Turning it on sends the trainee's transcribed sentence (and at most four earlier turns) to a third-party service: needs the privacy and consent decision of server/PRIVACY.md first.
INTERPRET_LLM_ENABLED=false
INTERPRET_LLM_MODEL=gemma4:31b
# Empty = the local Ollama (OLLAMA_URL), which relays a cloud model when signed in (use the -cloud model name there). https://ollama.com = the direct API with the key below.
INTERPRET_LLM_BASE_URL=
# Direct API only. Never commit a real key; keep it in the host's secret store.
INTERPRET_LLM_API_KEY=
INTERPRET_LLM_TIMEOUT_SECONDS=8
INTERPRET_LLM_BUDGET_MS=12000
INTERPRET_LLM_MAX_ATTEMPTS=2
# p1-ai-language-s19 (DT-238): hard = the head's critical-mass cap applies to a model candidate (the default). corroborated is an experiment that FAILED the bounded live panel check (docs/research/corroborated_cap_results.md): do not set it.
INTERPRET_LLM_CAP_POLICY=hard

# Per-task model routing (ADR-0026, content/ai/model_routes.json). Both switches are OFF: every task uses the local model.
# CLOUD_ROUTING_ENABLED lets tasks whose route names an Ollama Cloud model (free plan) use it; on any outage, usage limit or invalid reply the local model answers.
# Routes that send only authored synthetic content (scenario composition, critic, judge) need nothing else.
# CLOUD_TRAINEE_DATA_APPROVED records that the institutional and privacy requirements for sending trainees' words to Ollama Cloud are met (a qualified person reviewed the Terms and the Privacy Notice in content/legal, the institution completed its fields; DT-127, DT-248).
# It is not enough by itself: each person's words go to the cloud only if THAT person has also said yes to the optional cloud question (ADR-0027). Without their yes, or after they withdraw, the local model answers. Do NOT set it before the review.
CLOUD_ROUTING_ENABLED=false
CLOUD_TRAINEE_DATA_APPROVED=false
# CLOUD_SYNTHETIC_DEPLOYMENT: the owner's declaration that this deployment handles synthetic data only (development, demonstrations, invented trainees). It releases the trainee-class routes (patient dialogue, staff).
# It is not the privacy approval. NEVER set it on a deployment that real trainees use.
# The dedicated synthetic demonstration profile that turns these on together (and nothing else) is server/demo/synthetic-fyp-demo.env (task server-demo). The service refuses to start with it beside APP_ENV=prod or CLOUD_TRAINEE_DATA_APPROVED.
CLOUD_SYNTHETIC_DEPLOYMENT=false
