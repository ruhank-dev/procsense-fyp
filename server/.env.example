# Copy this file to server/.env (git-ignored) and fill in the real values from the password manager.
# Never commit real values: CI refuses a pushed key, token or database password (tools/ci/repo_checks.py).
# Every value below is a placeholder.

APP_ENV=dev

# Supabase project procsense-dev (public values; the reference is not a secret)
SUPABASE_URL=https://PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY

# SECRET. Server only: the host's environment variables, GitHub secrets and this local file. Never in the headset, a web page or git.
SUPABASE_SECRET_KEY=REPLACE_WITH_SECRET_KEY

# The application connects through the TRANSACTION pooler (port 6543). Prepared statements are switched off in code for this connection.
# Copy the exact host and user from the dashboard (Connect > Direct > Transaction pooler); the user looks like postgres.PROJECT-REF.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT-REF:YOUR-PASSWORD@POOLER-HOST:6543/postgres

# Migrations, backups and restores use the SESSION pooler (port 5432, IPv4). Never run migrations through the transaction pooler.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.PROJECT-REF:YOUR-PASSWORD@POOLER-HOST:5432/postgres

# Login tokens: the issuer and the key set address are derived from SUPABASE_URL (the project publishes its public keys at /auth/v1/.well-known/jwks.json).
# Optional, with these defaults: SUPABASE_JWT_AUDIENCE=authenticated, JWKS_CACHE_SECONDS=600, CLOCK_LEEWAY_SECONDS=10, INVITATION_DAYS=14

# Verification of uploaded sessions (p1-backend-s09). The engine's command line and a folder of content, one subfolder per content version (task server-engine-prepare builds both for the image).
# Empty ENGINE_CLI = verification is off and uploaded sessions wait as pending. A JSON list also works: ["dotnet", "/path/procsense-sim.dll"].
ENGINE_CLI=
ENGINE_CONTENT_ROOT=
VERIFY_TIMEOUT_SECONDS=60
VERIFY_BATCH=5
VERIFY_ON_UPLOAD=true
# SECRET. Lets a scheduled job call POST /internal/verify-pending (header X-Internal-Key). Empty = that route does not exist.
INTERNAL_KEY=

# Limits and versions (read by the service; defaults live in server/config.py once it exists)
MAX_UPLOAD_BYTES=2097152
MAX_PACKAGE_BYTES=1048576
UPLOAD_RATE_PER_HOUR=120
SUPPORTED_ENGINE_VERSIONS=
SUPPORTED_CONTENT_VERSIONS=
