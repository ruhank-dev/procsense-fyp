<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless runner: plays a case without Unity (used by tests and CI). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>procsense-sim</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProcSense.Core\ProcSense.Core.csproj" />
  </ItemGroup>

</Project>
