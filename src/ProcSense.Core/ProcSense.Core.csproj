<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deterministic simulation engine. netstandard2.1 + C# 9 = what Unity 6 can load.
       Must never reference UnityEngine, System.Random or DateTime.Now (see B-R11). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ProcSense.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
