#!/bin/sh
# ProcSense pre-push hook: runs the full local CI (`task ci`) before anything reaches main.
# Installed by `task setup` (git config core.hooksPath .githooks). Guide: docs/TEAM_GIT_WORKFLOW.md
#
# What it does
#   - A push that updates main/master (from any local branch: main, HEAD:main, feature:main) must pass `task ci`.
#   - It refuses to delete main, and refuses anything that is not a fast-forward of the remote main (no force-push).
#   - Pushes that do not touch main (feature branches, tags) pass straight through.
#
# What it cannot do
#   - It is a local convenience, not enforcement: `git push --no-verify` or editing core.hooksPath skips it.
#     GitHub Actions still runs CI after the push, but cannot stop a commit that has already arrived (docs/CI.md).

zero_only() { case "$1" in *[!0]*) return 1 ;; *) return 0 ;; esac; }

fail() {
  echo "pre-push: BLOCKED - $*" >&2
  exit 1
}

main_sha=""
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/master) ;;
    *) continue ;;
  esac

  if zero_only "$local_sha"; then
    fail "deleting $remote_ref is not allowed."
  fi

  if ! zero_only "$remote_sha"; then
    git cat-file -e "${remote_sha}^{commit}" 2>/dev/null ||
      fail "$remote_ref on GitHub has commits you do not have. Run 'git fetch origin', merge origin/main into your branch, run 'task ci', then push again."
    git merge-base --is-ancestor "$remote_sha" "$local_sha" ||
      fail "this is not a fast-forward of $remote_ref (a force-push, or main moved). Run 'git fetch origin', merge origin/main into your branch, run 'task ci', then push again. Never force-push."
  fi

  if [ -n "$main_sha" ] && [ "$main_sha" != "$local_sha" ]; then
    fail "two different commits are being pushed to main in one push. Push one at a time."
  fi
  main_sha="$local_sha"
done

# Nothing aimed at main: feature branches and tags are not checked here.
[ -z "$main_sha" ] && exit 0

# The checks test the files on disk, so the files on disk must be exactly the commit being pushed.
head_sha=$(git rev-parse HEAD) || fail "cannot read HEAD."
[ "$head_sha" = "$main_sha" ] ||
  fail "you are pushing a commit to main that is not the one checked out. Check it out first (for example 'git switch main'), then push again."
[ -z "$(git status --porcelain)" ] ||
  fail "uncommitted or untracked files found. Commit or stash them ('git status'), so the checks test exactly what you push."

for tool in git task dotnet uv; do
  command -v "$tool" >/dev/null 2>&1 ||
    fail "'$tool' is not installed or not on PATH, so the checks cannot run. Install it (winget install --id Task.Task -e / astral-sh.uv / Microsoft.DotNet.SDK.9 / Git.Git), restart the terminal, then push again."
done

echo "pre-push: running 'task ci' before updating main (about a minute)..." >&2
task ci || fail "'task ci' failed, so main was not updated. Fix the problem, commit, and push again."
echo "pre-push: all checks passed." >&2
exit 0
