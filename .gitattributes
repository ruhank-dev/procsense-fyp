* text=auto eol=lf

.githooks/* text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Unity: text-serialised assets merge as YAML
*.unity  text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.asset  text merge=unityyamlmerge eol=lf
*.meta   text eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.fbx  binary
*.blend binary
*.wav  binary
*.ogg  binary
*.pdf  binary
